7\u001b[0m     \u001b[0;34m@\u001b[0m\u001b[0mwraps\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mf\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    318\u001b[0m     \u001b[0;32mdef\u001b[0m \u001b[0mwrapped\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mself\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mX\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m*\u001b[0m\u001b[0margs\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m**\u001b[0m\u001b[0mkwargs\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 319\u001b[0;31m         \u001b[0mdata_to_wrap\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mf\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mself\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mX\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m*\u001b[0m\u001b[0margs\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m**\u001b[0m\u001b[0mkwargs\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    320\u001b[0m         \u001b[0;32mif\u001b[0m \u001b[0misinstance\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mdata_to_wrap\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mtuple\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    321\u001b[0m             \u001b[0;31m# only wrap the first output for cross decomposition\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/sklearn/base.py\u001b[0m in \u001b[0;36mwrapper\u001b[0;34m(estimator, *args, **kwargs)\u001b[0m\n\u001b[1;32m   1387\u001b[0m                 )\n\u001b[1;32m   1388\u001b[0m             ):\n\u001b[0;32m-> 1389\u001b[0;31m                 \u001b[0;32mreturn\u001b[0m \u001b[0mfit_method\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mestimator\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m*\u001b[0m\u001b[0margs\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0;34m**\u001b[0m\u001b[0mkwargs\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   1390\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1391\u001b[0m         \u001b[0;32mreturn\u001b[0m \u001b[0mwrapper\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/sklearn/compose/_column_transformer.py\u001b[0m in \u001b[0;36mfit_transform\u001b[0;34m(self, X, y, **params)\u001b[0m\n\u001b[1;32m    991\u001b[0m         \u001b[0mn_samples\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0m_num_samples\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mX\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    992\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 993\u001b[0;31m         \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0m_validate_column_callables\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mX\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    994\u001b[0m         \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0m_validate_remainder\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mX\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    995\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/sklearn/compose/_column_transformer.py\u001b[0m in \u001b[0;36m_validate_column_callables\u001b[0;34m(self, X)\u001b[0m\n\u001b[1;32m    550\u001b[0m                 \u001b[0mcolumns\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mcolumns\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mX\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    551\u001b[0m             \u001b[0mall_columns\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mappend\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mcolumns\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 552\u001b[0;31m             \u001b[0mtransformer_to_input_indices\u001b[0m\u001b[0;34m[\u001b[0m\u001b[0mname\u001b[0m\u001b[0;34m]\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0m_get_column_indices\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mX\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mcolumns\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    553\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    554\u001b[0m         \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0m_columns\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mall_columns\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;32m/usr/local/lib/python3.13/dist-packages/sklearn/utils/_indexing.py\u001b[0m in \u001b[0;36m_get_column_indices\u001b[0;34m(X, key)\u001b[0m\n\u001b[1;32m    370\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    371\u001b[0m         \u001b[0;32mexcept\u001b[0m \u001b[0mKeyError\u001b[0m \u001b[0;32mas\u001b[0m \u001b[0me\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 372\u001b[0;31m             \u001b[0;32mraise\u001b[0m \u001b[0mValueError\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m\"A given column is not a column of the dataframe\"\u001b[0m\u001b[0;34m)\u001b[0m \u001b[0;32mfrom\u001b[0m \u001b[0me\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    373\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    374\u001b[0m         \u001b[0;32mreturn\u001b[0m \u001b[0mcolumn_indices\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mValueError\u001b[0m: A given column is not a column of the dataframe"],"ename":"ValueError","evalue":"A given column is not a column of the dataframe","output_type":"error"}],"execution_count":9},{"cell_type":"code","source":"\nfrom sklearn.base import clone\nfrom sklearn.compose import ColumnTransformer\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.preprocessing import OneHotEncoder, StandardScaler\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.metrics import (\n    accuracy_score, precision_score, recall_score,\n    f1_score, roc_auc_score\n)\nimport pandas as pd\nimport numpy as np\n\n# Модель A: с TotalCharges\nmodel_A = clone(model)\nmodel_A.fit(X_train, y_train)\n\n# Модель B: без TotalCharges\nX_train_B = X_train.drop(columns=[\"TotalCharges\"])\nX_val_B = X_val.drop(columns=[\"TotalCharges\"])\n\nnumeric_cols_B = [\n    col for col in numeric_cols\n    if col != \"TotalCharges\"\n]\n\ncategorical_cols_B = categorical_cols\n\nnumeric_pipeline_B = Pipeline([\n    (\"imputer\", SimpleImputer(strategy=\"median\")),\n    (\"scaler\", StandardScaler())\n])\n\ncategorical_pipeline_B = Pipeline([\n    (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n    (\"encoder\", OneHotEncoder(handle_unknown=\"ignore\"))\n])\n\npreprocessor_B = ColumnTransformer([\n    (\"num\", numeric_pipeline_B, numeric_cols_B),\n    (\"cat\", categorical_pipeline_B, categorical_cols_B)\n])\n\nmodel_B = Pipeline([\n    (\"preprocessor\", preprocessor_B),\n    (\"classifier\", LogisticRegression(max_iter=1000))\n])\n\nmodel_B.fit(X_train_B, y_train)\n\n# Сравниваем качество на одной проверочной выборке\nprob_A = model_A.predict_proba(X_val)[:, 1]\nprob_B = model_B.predict_proba(X_val_B)[:, 1]\n\npred_A = (prob_A >= 0.5).astype(int)\npred_B = (prob_B >= 0.5).astype(int)\n\nresults = pd.DataFrame({\n    \"Metric\": [\"Accuracy\", \"Precision\", \"Recall\", \"F1\", \"ROC-AUC\"],\n    \"With_TotalCharges\": [\n        accuracy_score(y_val, pred_A),\n        precision_score(y_val, pred_A),\n        recall_score(y_val, pred_A),\n        f1_score(y_val, pred_A),\n        roc_auc_score(y_val, prob_A)\n    ],\n    \"Without_TotalCharges\": [\n        accuracy_score(y_val, pred_B),\n        precision_score(y_val, pred_B),\n        recall_score(y_val, pred_B),\n        f1_score(y_val, pred_B),\n        roc_auc_score(y_val, prob_B)\n    ]\n})\n\nprint(\"Сравнение качества моделей:\")\ndisplay(results.round(4))\n\ndef get_coefficient_table(fitted_model):\n    names = fitted_model.named_steps[\"preprocessor\"].get_feature_names_out()\n    coefs = fitted_model.named_steps[\"classifier\"].coef_[0]\n\n    return pd.DataFrame({\n        \"Feature\": names,\n        \"Coefficient\": coefs,\n        \"OddsRatio\": np.exp(coefs)\n    })\n\ncoef_A = get_coefficient_table(model_A)\ncoef_B = get_coefficient_table(model_B)\n\nprint(\"MonthlyCharges — модель A:\")\ndisplay(\n    coef_A[coef_A[\"Feature\"] == \"num__MonthlyCharges\"].round(4)\n)\n\nprint(\"MonthlyCharges — модель B:\")\ndisplay(\n    coef_B[coef_B[\"Feature\"] == \"num__MonthlyCharges\"].round(4)\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-23T04:35:30.401977Z","iopub.execute_input":"2026-10-23T04:35:30.402362Z","iopub.status.idle":"2026-10-23T04:35:30.755821Z","shell.execute_reply.started":"2026-10-23T04:35:30.402336Z","shell.execute_reply":"2026-10-23T04:35:30.755099Z"}},"outputs":[{"name":"stdout","text":"Сравнение качества моделей:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"      Metric  With_TotalCharges  Without_TotalCharges\n0   Accuracy             0.8055                0.7977\n1  Precision             0.6572                0.6378\n2     Recall             0.5588                0.5508\n3         F1             0.6040                0.5911\n4    ROC-AUC             0.8419                0.8391","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Metric</th>\n      <th>With_TotalCharges</th>\n      <th>Without_TotalCharges</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>Accuracy</td>\n      <td>0.8055</td>\n      <td>0.7977</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>Precision</td>\n      <td>0.6572</td>\n      <td>0.6378</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>Recall</td>\n      <td>0.5588</td>\n      <td>0.5508</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>F1</td>\n      <td>0.6040</td>\n      <td>0.5911</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>ROC-AUC</td>\n      <td>0.8419</td>\n      <td>0.8391</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"MonthlyCharges — модель A:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"               Feature  Coefficient  OddsRatio\n2  num__MonthlyCharges      -0.5964     0.5508","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Feature</th>\n      <th>Coefficient</th>\n      <th>OddsRatio</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>2</th>\n      <td>num__MonthlyCharges</td>\n      <td>-0.5964</td>\n      <td>0.5508</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"MonthlyCharges — модель B:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"               Feature  Coefficient  OddsRatio\n2  num__MonthlyCharges      -0.5021     0.6052","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Feature</th>\n      <th>Coefficient</th>\n      <th>OddsRatio</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>2</th>\n      <td>num__MonthlyCharges</td>\n      <td>-0.5021</td>\n      <td>0.6052</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":10},{"cell_type":"code","source":"\n# Создаём четыре группы по ежемесячной плате\ndf[\"ChargeGroup\"] = pd.qcut(\n    df[\"MonthlyCharges\"],\n    q=4,\n    labels=[\"Низкая\", \"Средняя\", \"Выше средней\", \"Высокая\"]\n)\n\n# Считаем размер групп и долю оттока\nprice_interaction = df.pivot_table(\n    index=[\"Contract\", \"InternetService\"],\n    columns=\"ChargeGroup\",\n    values=\"Churn\",\n    aggfunc=lambda x: (x == \"Yes\").mean() * 100,\n    observed=False\n)\n\nprint(\"Отток по цене внутри контрактов и типов интернета, %:\")\ndisplay(price_interaction.round(2))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-23T04:36:34.098875Z","iopub.execute_input":"2026-10-23T04:36:34.099341Z","iopub.status.idle":"2026-10-23T04:36:34.166253Z","shell.execute_reply.started":"2026-10-23T04:36:34.099315Z","shell.execute_reply":"2026-10-23T04:36:34.165452Z"}},"outputs":[{"name":"stdout","text":"Отток по цене внутри контрактов и типов интернета, %:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"ChargeGroup                     Низкая  Средняя  Выше средней  Высокая\nContract       InternetService                                        \nMonth-to-month DSL               41.21    31.58         16.22      NaN\n               Fiber optic         NaN    59.75         55.78    52.18\n               No                18.89      NaN           NaN      NaN\nOne year       DSL               10.00     8.63         10.84     0.00\n               Fiber optic         NaN      NaN         11.46    20.99\n               No                 2.47      NaN           NaN  